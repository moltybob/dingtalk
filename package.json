{
  "name": "@moltybob/dingtalk",
  "version": "0.2.1",
  "type": "module",
  "description": "DingTalk channel plugin for OpenClaw",
  "repository": "moltybob/dingtalk",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "dingtalk",
      "label": "DingTalk",
      "selectionLabel": "DingTalk (Bot API)",
      "docsPath": "/channels/dingtalk",
      "docsLabel": "dingtalk",
      "blurb": "Chinese messaging and collaboration platform with Bot API.",
      "aliases": [
        "dt"
      ],
      "order": 55,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@moltybob/dingtalk",
      "localPath": "extensions/dingtalk",
      "defaultChoice": "npm"
    }
  },
  "scripts": {
    "test": "node --import tsx --test test/auth.test.ts test/media.test.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@alicloud/dingtalk": "^2.2.38",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-typescript": "^1.8.0",
    "@alicloud/tea-util": "^1.4.11",
    "axios": ">=1.6.0",
    "dingtalk-stream": "^2.1.4",
    "zod": "^4.3.6",
    "form-data": "^4.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.1.29"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
