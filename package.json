{
  "name": "@moltybob/dingtalk",
  "version": "2026.1.28-beta.6",
  "type": "module",
  "description": "DingTalk channel plugin for Clawdbot",
  "repository": {
    "type": "git",
    "url": "https://github.com/moltbot/moltbot",
    "branch": "support-clawdbot"
  },
  "clawdbot": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "dingtalk",
      "label": "DingTalk",
      "selectionLabel": "DingTalk (Bot API)",
      "docsPath": "/channels/dingtalk",
      "docsLabel": "dingtalk",
      "blurb": "Chinese messaging and collaboration platform with Bot API.",
      "aliases": [
        "dt"
      ],
      "order": 55,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@moltybob/dingtalk",
      "localPath": "extensions/dingtalk",
      "defaultChoice": "npm"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "dingtalk-stream": "^2.1.4",
    "axios": ">=1.6.0",
    "zod": ">=3.22.0",
    "@alicloud/dingtalk": "^2.2.38",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-typescript": "^1.8.0",
    "@alicloud/tea-util": "^1.4.11"
  },
  "peerDependencies": {
    "clawdbot": ">=2026.1.24"
  }
}